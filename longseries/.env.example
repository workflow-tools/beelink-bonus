# `docker compose run --rm setup` writes .env for you (contact, data root, one watchdog URL per
# source) and keeps whatever is already there. Edit by hand only to change something. Do NOT copy
# this file to .env — setup treats these example values as placeholders and replaces them.
LONGSERIES_CONTACT=mailto:you@example.com          # goes into the User-Agent so the publisher can reach you
# One healthchecks.io check PER SOURCE (period 1 day, grace 6 h). A shared check would let a dead
# source hide behind a live sibling's pings. The free tier has 20 checks. setup creates these from
# HEALTHCHECKS_API_KEY, which is passed on the command line for that one run and never stored here.
LONGSERIES_HEARTBEAT_URL_AMPRION=https://hc-ping.com/uuid-amprion
LONGSERIES_HEARTBEAT_URL_TRANSNETBW=https://hc-ping.com/uuid-transnetbw
LONGSERIES_HEARTBEAT_URL_50HERTZ=https://hc-ping.com/uuid-50hertz
LONGSERIES_DATA=/srv/longseries                    # where bronze/ lives on this host; THIS IS THE ASSET — back it up
